BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Через запятую: id админов (Telegram user id)
ADMIN_IDS=123456789,987654321

# Postgres (используется docker-compose сервисом db)
POSTGRES_DB=support_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy async URL (используется ботом)
# Можно оставить как есть, либо собрать из переменных выше (docker compose подставит значения).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/support_bot
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis (FSM storage)
REDIS_URL=redis://redis:6379/0

# Remnawave panel API (пример — подстройте под реальный API)
REMNAWAVE_API_BASE_URL=https://panel.example.com/api
REMNAWAVE_API_TOKEN=replace_me
# Если панель защищена Caddy Auth (опционально)
REMNAWAVE_CADDY_API_KEY=

# Логи
LOG_LEVEL=INFO
